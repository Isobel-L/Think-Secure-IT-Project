# Read on the server only. Never put these in frontend code or commit them to Git.
OPENAI_API_KEY=sk-your-api-key

# Leave empty for the official OpenAI API; set it to use an OpenAI-compatible gateway.
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2

# This build has no database and no accounts: every visitor shares one guest identity, and
# login, registration and payments are disabled.
# Where full-size PNGs and 256px WebP thumbnails go; metadata lives in generations.json there.
AVATAR_STORAGE_DIR=./data/avatars
# How many records to keep; older ones are dropped together with their image files.
GUEST_HISTORY_LIMIT=200

# Image backend: openai, local-sd1.5 or comfyui.
# openai: calls OPENAI_IMAGE_MODEL.
# local-sd1.5: calls a local model service whose /api/generate matches the front-and-back/sd1.5 branch.
# comfyui: calls a local ComfyUI; the default workflow targets flux1-schnell-fp8.safetensors.
IMAGE_BACKEND=openai

# Local SD1.5 service address. Start the model service separately first:
# python app/server.py --host 127.0.0.1 --port 8000
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000
LOCAL_MODEL_WIDTH=512
LOCAL_MODEL_HEIGHT=512
LOCAL_MODEL_STEPS=20
LOCAL_MODEL_CFG=7.5
LOCAL_MODEL_SEED=-1
LOCAL_MODEL_TIMEOUT_MS=240000

# Local ComfyUI / FLUX.1-schnell service address.
# Start ComfyUI first and confirm http://127.0.0.1:8188 opens.
# Recommended FLUX.1 Schnell defaults live in shared/modelProfiles.js; creative options in the UI
# never override the sampling settings.
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Initial generation always uses FLUX.1. Qwen can translate Chinese prompts before generation.
COMFY_GENERATION_ENGINE=flux1
COMFY_PROMPT_MODE=flux1-qwen
COMFY_TRANSLATOR_CLIP_NAME=qwen_3_4b.safetensors
COMFY_TRANSLATOR_CLIP_TYPE=flux2
COMFY_TRANSLATOR_MAX_LENGTH=384
COMFY_TRANSLATOR_RETRIES=1
COMFY_CHECKPOINT_NAME=flux1-schnell-fp8.safetensors
COMFY_WIDTH=1024
COMFY_HEIGHT=1024
COMFY_STEPS=4
COMFY_CFG=1
COMFY_SAMPLER_NAME=euler
COMFY_SCHEDULER=simple
COMFY_SEED=-1
COMFY_POLL_INTERVAL_MS=1500
COMFY_MAX_POLL_ATTEMPTS=120
COMFY_TIMEOUT_MS=30000

# Local FLUX.2 Klein image-editing model and sampling settings.
# Its recommended defaults also come from the model profile; the variables below are operational
# overrides only.
COMFY_FLUX2_UNET_NAME=flux-2-klein-4b-fp8.safetensors
COMFY_FLUX2_CLIP_NAME=qwen_3_4b.safetensors
COMFY_FLUX2_VAE_NAME=flux2-vae.safetensors
COMFY_FLUX2_STEPS=4
COMFY_FLUX2_CFG=1
COMFY_FLUX2_SAMPLER_NAME=euler
COMFY_FLUX2_SCHEDULER=simple
COMFY_FLUX2_SEED=-1
COMFY_FLUX2_MASK_FEATHER=8
COMFY_EDIT_MAX_UPLOAD_MB=10

PORT=8787
