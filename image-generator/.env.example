# 仅在服务端读取，不要写进前端代码或提交到 Git。
OPENAI_API_KEY=sk-your-api-key

# 官方 OpenAI API 可留空；兼容网关可填写对应地址。
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2

# 账号系统与 Docker Postgres。
# 本地开发可先运行：docker compose up -d db
DATABASE_URL=postgres://tmall_avatar:tmall_avatar_dev@127.0.0.1:5432/tmall_avatar
# 生成原图与 256px WebP 缩略图的持久化目录。
AVATAR_STORAGE_DIR=./data/avatars
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_BASE_URL=http://127.0.0.1:5173
PUBLIC_API_BASE_URL=http://127.0.0.1:8787
COOKIE_SECURE=false

# Google OAuth，可先留空；留空时 Google 登录按钮会提示未配置。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 支付方式：auto 会优先使用支付宝直连，未配置时回退 Stripe；也可固定为 alipay 或 stripe。
PAYMENT_PROVIDER=auto
# 仅本机开发调试使用。正式环境必须保持 false。
ENABLE_TEST_PAYMENTS=false
DEV_UNLIMITED_USAGE=false

# 支付宝开放平台“电脑网站支付”。密钥只保存在服务端。
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 支付宝必须能通过公网 HTTPS 访问此回调；留空时由 PUBLIC_API_BASE_URL 自动拼接。
ALIPAY_NOTIFY_URL=
# 可选：支付宝商户 PID。填写后会额外校验异步通知中的 seller_id。
ALIPAY_SELLER_ID=

# Stripe Checkout 支付宝备用方案。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 图片生成后端：openai、local-sd1.5 或 comfyui。
# openai：调用 OPENAI_IMAGE_MODEL。
# local-sd1.5：调用本地模型服务，接口兼容 front-and-back/sd1.5 分支的 /api/generate。
# comfyui：调用本地 ComfyUI，默认工作流适配 flux1-schnell-fp8.safetensors。
IMAGE_BACKEND=openai

# 本地 SD1.5 服务地址。先单独启动本地模型服务：
# python app/server.py --host 127.0.0.1 --port 8000
LOCAL_MODEL_BASE_URL=http://127.0.0.1:8000
LOCAL_MODEL_WIDTH=512
LOCAL_MODEL_HEIGHT=512
LOCAL_MODEL_STEPS=20
LOCAL_MODEL_CFG=7.5
LOCAL_MODEL_SEED=-1
LOCAL_MODEL_TIMEOUT_MS=240000

# 本地 ComfyUI / FLUX.1-schnell 服务地址。
# 先启动 ComfyUI，并确认 http://127.0.0.1:8188 可以打开。
# FLUX.1 Schnell 推荐默认值由 shared/modelProfiles.js 管理；网页创意参数不会覆盖采样设置。
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Initial generation always uses FLUX.1. Qwen can translate Chinese prompts before generation.
COMFY_GENERATION_ENGINE=flux1
COMFY_PROMPT_MODE=flux1-qwen
COMFY_TRANSLATOR_CLIP_NAME=qwen_3_4b.safetensors
COMFY_TRANSLATOR_CLIP_TYPE=flux2
COMFY_TRANSLATOR_MAX_LENGTH=384
COMFY_TRANSLATOR_RETRIES=1
COMFY_CHECKPOINT_NAME=flux1-schnell-fp8.safetensors
COMFY_WIDTH=1024
COMFY_HEIGHT=1024
COMFY_STEPS=4
COMFY_CFG=1
COMFY_SAMPLER_NAME=euler
COMFY_SCHEDULER=simple
COMFY_SEED=-1
COMFY_POLL_INTERVAL_MS=1500
COMFY_MAX_POLL_ATTEMPTS=120
COMFY_TIMEOUT_MS=30000

# FLUX.2 Klein 本地图片编辑模型与采样设置。
# FLUX.2 Klein 编辑推荐默认值同样由模型档案管理，以下变量仅用于运维调试覆盖。
COMFY_FLUX2_UNET_NAME=flux-2-klein-4b-fp8.safetensors
COMFY_FLUX2_CLIP_NAME=qwen_3_4b.safetensors
COMFY_FLUX2_VAE_NAME=flux2-vae.safetensors
COMFY_FLUX2_STEPS=4
COMFY_FLUX2_CFG=1
COMFY_FLUX2_SAMPLER_NAME=euler
COMFY_FLUX2_SCHEDULER=simple
COMFY_FLUX2_SEED=-1
COMFY_FLUX2_MASK_FEATHER=8
COMFY_EDIT_MAX_UPLOAD_MB=10

PORT=8787
